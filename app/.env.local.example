# Firebase Client SDK Configuration
# Copy this file to .env.local and fill in your Firebase project values.
# Get these values from the Firebase Console > Project Settings > General > Your apps
#
# These are client-side values and are safe to expose in the browser.
# They identify the Firebase project but do not grant privileged access.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nil-rev-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nil-rev-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nil-rev-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id-here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id-here

# Set to "true" to connect to Firebase Emulators in local development
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
