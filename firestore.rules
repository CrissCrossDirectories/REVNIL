rules_version = '2';

/**
 * Firestore Security Rules — REVNIL (Subtask 0.3)
 *
 * Phase 0/1 goals implemented here:
 * - Tenant isolation across institutions, collectives, athletes
 * - Claim-based RBAC for tenant-scoped operations
 * - Consent-gated cross-tenant athlete reads
 * - Deny-by-default for everything not explicitly allowed
 */
service cloud.firestore {
  match /databases/{database}/documents {
    /** -----------------------------
     * Auth + claims helpers
     * ------------------------------ */
    function isSignedIn() {
      return request.auth != null;
    }

    function hasClaimString(claimKey) {
      return isSignedIn() &&
        request.auth.token[claimKey] is string &&
        request.auth.token[claimKey].size() > 0;
    }

    function tenantType() {
      return request.auth.token.tenantType;
    }

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function role() {
      return request.auth.token.role;
    }

    function hasValidTenantType() {
      return tenantType() == "institution" ||
        tenantType() == "collective" ||
        tenantType() == "athlete" ||
        tenantType() == "agent";
    }

    function hasValidRole() {
      return role() == "org_admin" ||
        role() == "ad_leadership" ||
        role() == "coach" ||
        role() == "staff" ||
        role() == "athlete";
    }

    function hasValidTenantClaims() {
      return isSignedIn() &&
        hasClaimString("tenantType") &&
        hasClaimString("tenantId") &&
        hasClaimString("role") &&
        hasValidTenantType() &&
        hasValidRole();
    }

    function isRole(expectedRole) {
      return hasValidTenantClaims() && role() == expectedRole;
    }

    function isOrgLeadershipRole() {
      return isRole("org_admin") || isRole("ad_leadership");
    }

    function isSportScopedRole() {
      return isRole("coach") || isRole("staff");
    }

    function hasSportAssignments() {
      return hasValidTenantClaims() &&
        (request.auth.token.sportIds is list);
    }

    function hasSportAccess(sportId) {
      return isSportScopedRole() &&
        hasSportAssignments() &&
        request.auth.token.sportIds.hasAny([sportId]);
    }

    function canAccessInstitutionRosterDoc(institutionId) {
      return isInstitutionTenant(institutionId) &&
        (
          isOrgLeadershipRole() ||
          (
            isSportScopedRole() &&
            ('sport' in resource.data) &&
            resource.data.sport is string &&
            hasSportAccess(resource.data.sport)
          )
        );
    }

    function canMutateInstitutionRosterDoc(institutionId) {
      return isInstitutionTenant(institutionId) &&
        (
          isOrgLeadershipRole() ||
          (
            isSportScopedRole() &&
            ('sport' in request.resource.data) &&
            request.resource.data.sport is string &&
            hasSportAccess(request.resource.data.sport)
          )
        );
    }

    function isInstitutionUser() {
      return hasValidTenantClaims() && tenantType() == "institution";
    }

    function isCollectiveUser() {
      return hasValidTenantClaims() && tenantType() == "collective";
    }

    function isAthleteUser() {
      return hasValidTenantClaims() && tenantType() == "athlete";
    }

    function isAgentUser() {
      return hasValidTenantClaims() && tenantType() == "agent";
    }

    function isInstitutionTenant(institutionId) {
      return isInstitutionUser() && tenantId() == institutionId;
    }

    function isCollectiveTenant(collectiveId) {
      return isCollectiveUser() && tenantId() == collectiveId;
    }

    function isAthleteOwner(athleteId) {
      return isAthleteUser() && isRole("athlete") && tenantId() == athleteId;
    }

    function agentLinkedPath(athleteId) {
      return /databases/$(database)/documents/agents/$(tenantId())/linkedAthletes/$(athleteId);
    }

    function collectiveLinkedPath(athleteId) {
      return /databases/$(database)/documents/collectives/$(tenantId())/linkedAthletes/$(athleteId);
    }

    /** -----------------------------
     * Consent helpers
     * ------------------------------ */
    function consentDocPath(athleteId, readerTenantType, readerTenantId) {
      return /databases/$(database)/documents/athletes/$(athleteId)/consent/$(readerTenantType + "_" + readerTenantId);
    }

    function consentAllows(athleteId, readerTenantType, readerTenantId, permissionKey) {
      let consentPath = consentDocPath(athleteId, readerTenantType, readerTenantId);
      let hasConsent = exists(consentPath);
      let consentDoc = hasConsent ? get(consentPath) : null;
      let hasPermissions = hasConsent && ('permissions' in consentDoc.data) && consentDoc.data.permissions is map;

      return hasConsent &&
        consentDoc.data.granted == true &&
        (!('revoked' in consentDoc.data) || consentDoc.data.revoked == false) &&
        hasPermissions &&
        (
          ((permissionKey in consentDoc.data.permissions) && consentDoc.data.permissions[permissionKey] == true) ||
          (("readAll" in consentDoc.data.permissions) && consentDoc.data.permissions.readAll == true)
        );
    }

    function hasConsentForCurrentTenant(athleteId, permissionKey) {
      return consentAllows(athleteId, tenantType(), tenantId(), permissionKey);
    }

    function institutionCanReadAthleteProfile(athleteId) {
      return isInstitutionUser() && isOrgLeadershipRole() && hasConsentForCurrentTenant(athleteId, "readProfile");
    }

    function institutionCanReadAthleteDeals(athleteId) {
      return isInstitutionUser() && isOrgLeadershipRole() && hasConsentForCurrentTenant(athleteId, "readDeals");
    }

    function collectiveCanReadAthleteDeals(athleteId) {
      return isCollectiveUser() &&
        exists(collectiveLinkedPath(athleteId)) &&
        hasConsentForCurrentTenant(athleteId, "readDeals");
    }

    function agentCanReadAthlete(athleteId, permissionKey) {
      return isAgentUser() &&
        exists(agentLinkedPath(athleteId)) &&
        hasConsentForCurrentTenant(athleteId, permissionKey);
    }

    /** -----------------------------
     * Institutions
     * ------------------------------ */
    match /institutions/{institutionId} {
      allow read, write: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();

      match /profile/{docId} {
        allow read, write: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();
      }

      match /config/{docId} {
        allow read, write: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();
      }

      match /titleIX/{docId} {
        allow read, write: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();
      }

      match /roster/{athleteId} {
        allow read: if canAccessInstitutionRosterDoc(institutionId);
        allow create, update: if canMutateInstitutionRosterDoc(institutionId);
        allow delete: if canAccessInstitutionRosterDoc(institutionId);
      }

      match /capManagement/{docId} {
        allow read, create, update, delete: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();
      }

      match /riskAlerts/{alertId} {
        allow read, create, update, delete: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();
      }

      match /imports/{importId} {
        allow read, create, update, delete: if isInstitutionTenant(institutionId) && isOrgLeadershipRole();
      }
    }

    /** -----------------------------
     * Collectives
     * ------------------------------ */
    match /collectives/{collectiveId} {
      allow read, write: if isCollectiveTenant(collectiveId) && (isOrgLeadershipRole() || isRole("staff"));

      match /profile/{docId} {
        allow read, write: if isCollectiveTenant(collectiveId);
      }

      match /deals/{dealId} {
        allow read, write: if isCollectiveTenant(collectiveId);
      }

      match /activations/{activationId} {
        allow read, write: if isCollectiveTenant(collectiveId);
      }

      match /donors/{donorId} {
        allow read, write: if isCollectiveTenant(collectiveId);
      }

      match /financials/{docId} {
        allow read, write: if isCollectiveTenant(collectiveId);
      }
    }

    /** -----------------------------
     * Athletes
     * ------------------------------ */
    match /athletes/{athleteId} {
      allow read, write: if isAthleteOwner(athleteId);

      match /profile/{docId} {
        allow read: if isAthleteOwner(athleteId) ||
          institutionCanReadAthleteProfile(athleteId) ||
          agentCanReadAthlete(athleteId, "readProfile");
        allow create, update, delete: if isAthleteOwner(athleteId);
      }

      match /income/{docId} {
        allow read, write: if isAthleteOwner(athleteId);
      }

      match /deals/{dealId} {
        allow read: if isAthleteOwner(athleteId) ||
          institutionCanReadAthleteDeals(athleteId) ||
          collectiveCanReadAthleteDeals(athleteId) ||
          agentCanReadAthlete(athleteId, "readDeals");
        allow create, update, delete: if isAthleteOwner(athleteId);
      }

      match /consent/{docId} {
        allow read, write: if isAthleteOwner(athleteId);
      }
    }

    /** -----------------------------
     * Connect module
     * Path skeleton:
     * - /connect/{connectId}/conversations/{conversationId}/messages/{messageId}
     * - /connect/notifications/{userId}/{notificationId}
     * ------------------------------ */
    function conversationPath(connectId, conversationId) {
      return /databases/$(database)/documents/connect/$(connectId)/conversations/$(conversationId);
    }

    function canAccessConversation(connectId, conversationId) {
      let path = conversationPath(connectId, conversationId);
      let isValid = hasValidTenantClaims() && exists(path);
      let convo = isValid ? get(path) : null;

      return isValid &&
        ('participantUids' in convo.data) &&
        convo.data.participantUids is list &&
        request.auth.uid in convo.data.participantUids;
    }

    match /connect/{connectId}/conversations/{conversationId} {
      allow read, update, delete: if canAccessConversation(connectId, conversationId);
      allow create: if hasValidTenantClaims() &&
        request.resource.data.participantUids is list &&
        request.auth.uid in request.resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if canAccessConversation(connectId, conversationId);
        allow create: if canAccessConversation(connectId, conversationId) &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /connect/notifications/{userId}/{notificationId} {
      allow read: if hasValidTenantClaims() && request.auth.uid == userId;
      allow create, update, delete: if hasValidTenantClaims() && request.auth.uid == userId;
    }

    /** -----------------------------
     * Explicit deny-by-default
     * ------------------------------ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
